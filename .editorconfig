# EditorConfig — https://editorconfig.org
#
# Universal style baseline + ktlint rule overrides for the SDK (BEE-63).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts,java}]
indent_size = 4
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# ── ktlint rule overrides (BEE-63) ────────────────────────────────────────────
# package-name: the public namespace is `com.beeping.AndroidBeepingCore` (mixed
#   case) — that's the SDK's published Kotlin/Java package, exposed to every
#   consumer. Renaming it is a breaking API change for downstream apps and is
#   out of scope of the lint task.
# function-naming: BeepingCoreJNI.kt declares JNI external functions whose
#   names must match the C entry points exported by `libbeepingcore.so`
#   (e.g. native methods called from generated `Java_…_*` symbols).
[*.{kt,kts}]
ktlint_standard_package-name = disabled
ktlint_standard_function-naming = disabled

[*.{xml,html,svg}]
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.gradle]
indent_size = 4

[*.{properties,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2
