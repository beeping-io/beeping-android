# Documented schema for `.env.local` (the actual values live in `.env.local`,
# which is gitignored). Copy this file as a starting point:
#
#   cp .env.example .env.local
#
# Then fill in personal values where needed.

# === Beepbox Cloud (BeepingMode.Cloud) ===
# Base URL of the beepbox-server HTTP API.
# - Production: https://api.beeping.io
# - Development: see beeping-www/.env.development -> NEXT_PUBLIC_BEEPBOX_URL
BEEPBOX_BASE_URL=https://api.beeping.io

# Personal API key generated via the developer portal (Phase 17 — not yet built)
# or via the Firebase Cloud Function `generateApiKey` directly.
# Used by:
#   - CloudEncoderTest opt-in E2E (BEE-57+)
#   - Local smoke scripts hitting live cloud
# Optional — CI tests use Ktor MockEngine and don't need a real key.
BEEPBOX_API_KEY=

# === Linear ===
# Personal API key for Linear (https://linear.app/settings/api).
# Used by `/worktree-start`-style scripted curls.
LINEAR_API_KEY=
